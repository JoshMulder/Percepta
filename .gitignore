# Claude Code's machine-local settings. The project's own ignores live in
# server/.gitignore, which only covers that subtree.
.claude/settings.local.json

# Scratch venvs anywhere in the tree.
**/.venv/

# Python bytecode, wherever it lands.
__pycache__/
*.py[cod]

# Agent worktrees: working copies of this same repo, never content of it.
.claude/worktrees/

percepta.txt
# A site's own settings, written by the bootstrap scripts. Never committed:
# `git pull` is the update path, and it must not be able to clobber the answers
# somebody gave when the box was commissioned. It also carries the setup page's
# password hash, which is the one secret either file is allowed to hold.
station/.env
# The old location, kept so that moving the file does not make a bench box's
# existing one suddenly tracked. Nothing writes here any more.
station/deploy/.env
server/.env
