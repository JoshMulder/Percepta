# Claude Code's machine-local settings. The project's own ignores live in
# server/.gitignore, which only covers that subtree.
.claude/settings.local.json

# Scratch venvs anywhere in the tree.
**/.venv/

# Python bytecode, wherever it lands.
__pycache__/
*.py[cod]

# Agent worktrees: working copies of this same repo, never content of it.
.claude/worktrees/

percepta.txt