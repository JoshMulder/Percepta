# When the station looks for an update.
#
# Pull on a timer, because nothing can reach inward: Starlink is CGNAT and the
# platform can never initiate a connection to a station
# (contract/enrolment.md §1). The station asks; nobody tells it.
#
# The cost of asking is small enough to make this uncontroversial: a check that
# finds nothing new is **about 6 KB** (an auth token and a manifest HEAD), so
# four checks a day is ~24 KB — against roughly 113 MB/day of telemetry from
# this station. Measured against a real registry; DECISIONS.md item 40.

[Unit]
Description=Percepta ground station — periodic update check
Documentation=file:/opt/percepta/station/DEPLOYMENT.md

[Timer]
# Not at boot. A station that has just come up should prove it is working on
# the image it already has before being handed a new one — and a box caught in
# a boot loop must not pull a fresh image on every cycle.
OnBootSec=30min
OnUnitActiveSec=6h

# **The most important line here.** Without it, every station in a fleet checks
# in the same minute, so a bad image reaches all of them at once and they fail
# together. Spread over two hours, a bad update takes out the first station
# well before the last one has looked — which is the difference between one
# site visit and all of them.
RandomizedDelaySec=2h

# A box that was powered off through its window checks once when it comes back
# rather than waiting for the next one.
Persistent=true

[Install]
WantedBy=timers.target
