# The ground station agent, as a systemd service.
#
# Installed to /etc/systemd/system/gsu.service by deploy/install.sh.
#
# Two constraints from station/README.md shape everything here:
#
#   "The link drops, routinely."  So this unit must start, and keep running,
#   with no network at all. There is no network-online.target dependency and no
#   Requires= on anything remote. A box that will not boot without the platform
#   is a box that stops working when the link does.
#
#   "Nobody is there."  So it restarts for ever, with no start-rate limit. A
#   service that gives up after five attempts is a site visit; on a remote site
#   the correct behaviour for a crash loop is to keep trying and keep saying so.
#
# That second constraint has a sharp edge, and the assertion below is what
# blunts it. Both unit files are installed on either deployment path so that
# switching is one systemctl command, and on the container path this one is
# merely *disabled* — which stops it at boot and does nothing at all to stop a
# person typing `systemctl restart gsu`. On a container box the venv this unit
# execs does not exist, so that start fails, and "restarts for ever, no rate
# limit" turns one keystroke into an unbounded crash loop. Found in the field at
# 72 restarts, next to a perfectly healthy container serving the same station.
#
# Everything under [Service] that is not Exec* is hardening. The comments say
# what each one buys and, where it matters, what it would break — a hardening
# line nobody understands is a line somebody deletes at 2am.

[Unit]
Description=Percepta ground station agent
Documentation=file:/opt/percepta/station/DEPLOYMENT.md
# Ordering only, never a requirement: local filesystems must be mounted before
# state is written, and if the network happens to be up first, good.
After=local-fs.target network.target
Wants=network.target
# Deliberately NOT After=time-sync.target: that waits for NTP, which waits for
# the network. The agent handles an implausible clock itself — it refuses to
# enrol and raises a health condition (contract/enrolment.md §6) — and it must
# be sensing and recording long before it knows what time it is.
StartLimitIntervalSec=0

# The interpreter this unit execs, asserted before anything is spawned. It
# exists only on the systemd path — the container path never builds a venv — so
# this is the question "am I the deployment path in use here?" asked in the one
# form that cannot drift from the answer: it is character-for-character the
# prefix of ExecStart below, and a test holds the two together.
#
# Assert rather than Condition on purpose. A failed condition skips the unit
# quietly, and a station that silently does nothing when told to start is worse
# than one that refuses out loud. A failed assertion marks the unit failed and
# writes the missing path into the journal — and, unlike an ExecStart that dies,
# neither form triggers Restart=, so there is no loop either way.
AssertPathExists=/opt/percepta/station/.venv/bin/python

[Service]
Type=exec
User=gsu
Group=gsu
# dialout: the two USB-UARTs (Airmar, ping RX Pro).
# video:   the Pi camera, for when a driver exists.
# plugdev: the RTL-SDR dongle, via the udev rule installed alongside this.
SupplementaryGroups=dialout video plugdev

WorkingDirectory=/opt/percepta/station
EnvironmentFile=/etc/percepta/gsu.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/percepta/station/.venv/bin/python -m gsu run

Restart=always
RestartSec=5s
# The radio must be stopped through its own shutdown path, never killed: a
# dongle killed mid-transfer needs a physical replug, and on this site that is a
# truck (server/docs/05-radio-integration.md, obligation 2). SIGTERM reaches the
# agent's handler, which shuts the receiver down in order; 45s is generous
# enough that systemd never has to escalate to SIGKILL.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=45s

# --- state ---------------------------------------------------------------
# /var/lib/percepta-gsu, created 0700 and owned by gsu. The credential and the
# pinned CA live in here at 0600, so the directory must not be world-readable.
StateDirectory=percepta-gsu
StateDirectoryMode=0700
UMask=0077

# --- hardening -----------------------------------------------------------
# The agent needs: its state directory, two serial devices, a USB SDR, the
# network, and nothing else at all.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
# The agent reads the clock and never sets it — that is chrony's job. This also
# drops CAP_SYS_TIME, so a compromised agent cannot strand the site by moving
# the clock past its own credential's expiry.
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
# No capabilities whatsoever. Nothing here needs one.
CapabilityBoundingSet=
AmbientCapabilities=
# AF_NETLINK is not optional despite looking it: glibc's getaddrinfo() uses it
# to enumerate local addresses, so removing it breaks DNS resolution and the
# station cannot find the broker.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# CPython and the one pure-Python dependency (redis) need no writable-executable
# pages. If a native extension is ever added and the service fails to start with
# a memory-protection error, this is the first line to try removing — and the
# reason should be written down when it is.
MemoryDenyWriteExecute=yes

# PrivateDevices is deliberately NOT set: it would replace /dev with a minimal
# set and take away /dev/ttyUSB*, /dev/serial/by-id and the SDR. The device
# allow-list below is the narrower control instead.
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw
DeviceAllow=char-ttyAMA rw
DeviceAllow=/dev/vchiq rw
DeviceAllow=char-usb_device rw
# The libcamera set, missing at first and found on the first real camera: the
# capture pipeline opens /dev/video* AND /dev/media* AND a dma_heap for its
# buffers, and DeviceAllow is an allow-list - one omission reads as
# "no cameras available" from a service whose user can see the camera
# perfectly well from a shell.
DeviceAllow=char-video4linux rw
DeviceAllow=char-media rw
DeviceAllow=char-dma_heap rw

# A remote box with a full disk is a site visit, and so is one that swaps itself
# to death on an SD card. The agent's own footprint is small; this is a fence,
# not a target.
MemoryMax=384M
TasksMax=64

[Install]
WantedBy=multi-user.target
