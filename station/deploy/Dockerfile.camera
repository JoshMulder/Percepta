# The agent **with the camera stack**, for a container station that has a CSI
# camera on it.
#
#   docker buildx build --platform linux/arm/v7 -f deploy/Dockerfile.camera \
#     --build-arg SUITE=trixie -t percepta/gsu-camera:0.1.0 .
#   sudo docker compose -f deploy/docker-compose.yml \
#                       -f deploy/docker-compose.camera.yml up -d
#
# ---------------------------------------------------------------------------
# **BUILT AND RUN on the first real station** — a Pi 2B rev 1.1, Raspberry Pi
# OS 13 (Trixie), armhf, ov5647 on the ribbon. The image builds at 271 MB.
# What it measured, which is the whole story of this file:
#
#   * The sensor **enumerates** and picamera2 **captured snapshots**, under
#     exactly docker-compose.camera.yml's constraints — the udev mount, the
#     widened device cgroup and the render gid were each necessary, and
#     together sufficient.
#   * `rpicam-vid` takes a **bus error in the encoder path and dies before one
#     frame** — Debian armhf userland against a Raspbian host. It spawns
#     cleanly and dies asynchronously, so retrying never helps. The identical
#     command on the host encodes 1080p30 through /dev/video11, so the fault
#     is this image's userland: not the kernel, not device access, not the
#     compose overlay.
#
# **So a camera-equipped station uses the systemd path**, and that was already
# true before the change below.
#
# ---------------------------------------------------------------------------
# **OPEN, AND NOT YET MEASURED.** The station no longer uses picamera2 at all
# (gsu/camera/picsi.py: it was the only thing putting a libcamera
# `CameraManager` inside the agent's process, and a leaked acquisition in there
# is unrecoverable for the life of the run). Capture is now `rpicam-jpeg`.
#
# That means **the one camera function this image was demonstrated to perform
# is now performed by a different binary, and that binary's sibling
# `rpicam-vid` is the one that bus-errors here.** Whether `rpicam-jpeg` shares
# the fault is unknown: the bus error was in the *encoder* path, which a still
# capture does not use, so it may well be fine — but nobody has run it. Until
# somebody does, this image should be assumed to have no working camera.
#
# One command settles it, on the Pi 2B, with the camera attached:
#
#   docker run --rm <the compose overlay's device flags> percepta/gsu-camera:… \
#     rpicam-jpeg --nopreview --timeout 300 --output /dev/shm/probe.jpg
#
# A file with a JPEG in it means the container path keeps a preview. A bus
# error means it has none, and the systemd path is the only camera route —
# which is what DEPLOYMENT.md §3 already recommends for other reasons.
#
# Three couplings, the first now demonstrated rather than predicted:
#
#   1. **Userland in here runs against drivers out there.** The container's
#      libcamera and rpicam-apps must be compatible with the *host's* kernel,
#      firmware — and, as the bus error showed, its architecture baseline.
#      Raspberry Pi OS updates its half of that pair with the kernel; a
#      container pins the other half. A mismatch presents as "no cameras
#      available", or as an encoder that dies before its first frame.
#   2. **SUITE must match the host's release.** Build with
#      `--build-arg SUITE=trixie` on Raspberry Pi OS 13, `bookworm` on 12. The
#      Raspberry Pi archive publishes per-suite, and mixing them is how you get
#      a libcamera built against a different kernel headers set.
#   3. **The device access is not the same as the base image's.** libcamera
#      opens more than /dev/video*, and it enumerates through udev. See
#      docker-compose.camera.yml, which is not optional.
#
# What this costs that the slim image does not: 271 MB measured against 40, and
# an update layer that is no longer 91 KB. That is a real loss on a metered
# link and it is the second reason the recommendation is systemd — DECISIONS.md
# item 40 has the measured update-bandwidth numbers this breaks.
# ---------------------------------------------------------------------------

ARG SUITE=trixie
FROM --platform=$TARGETPLATFORM debian:${SUITE}-slim

ARG SUITE
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    GSU_HOME=/var/lib/percepta-gsu

# The Raspberry Pi archive, which is where rpicam-apps and python3-picamera2
# come from — they are not in Debian proper. The keyring is fetched and
# dearmoured rather than trusted from a `curl | apt-key` pipeline, and the repo
# is pinned to the same suite as the base image.
COPY deploy/raspberrypi-archive-keyring.pgp /usr/share/keyrings/raspberrypi-archive-keyring.pgp
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates; \
    echo "deb [signed-by=/usr/share/keyrings/raspberrypi-archive-keyring.pgp] \
https://archive.raspberrypi.com/debian/ ${SUITE} main" \
      > /etc/apt/sources.list.d/raspi.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-redis \
        rpicam-apps \
        libcamera-ipa \
        libcamera-tools \
        ffmpeg; \
    apt-get autoremove -y; \
    rm -rf /var/lib/apt/lists/*

# Fail the build rather than the field if the distribution's redis is older than
# the floor the TLS code needs. `requirements.txt` says why 5.0 is a floor and
# not a preference: the station passes ssl_cert_reqs, ssl_check_hostname and
# ssl_ca_certs explicitly, and an older client silently ignores them.
RUN python3 - <<'PY'
import redis, sys
major = int(redis.__version__.split(".")[0])
print(f"redis {redis.__version__}")
sys.exit(0 if major >= 5 else "redis client is older than 5.0; this image cannot "
                              "verify the broker's certificate correctly")
PY

# Prove the camera stack is actually in the image. This checks packaging, not
# hardware — `rpicam-hello --list-cameras` needs a camera and cannot run at
# build time — but a missing binary is worth failing the build for.
#
# `python3-picamera2` is deliberately no longer installed or checked. The
# station does not import it and must not be able to: it is the only way a
# libcamera `CameraManager` gets inside the agent's own process, and an
# acquisition leaked in there cannot be released for the life of the run. See
# gsu/camera/picsi.py. Capture is `rpicam-jpeg`, one subprocess per frame,
# which is what these two lines now check for.
RUN command -v rpicam-jpeg && command -v rpicam-vid

# Same uid/gid as the slim image, so a bind-mounted state directory keeps
# working if a station is moved between the two.
RUN groupadd --system --gid 10001 gsu \
 && useradd --system --uid 10001 --gid gsu --no-create-home \
            --shell /usr/sbin/nologin gsu \
 && mkdir -p /var/lib/percepta-gsu \
 && chown gsu:gsu /var/lib/percepta-gsu \
 && chmod 0700 /var/lib/percepta-gsu

WORKDIR /opt/percepta/station
COPY README.md DECISIONS.md DEPLOYMENT.md HARDWARE.md CONTRACT-QUESTIONS.md ./
COPY gsu/ ./gsu/
RUN chown -R root:root /opt/percepta/station && chmod -R go-w /opt/percepta/station

USER gsu

# `python3`, not `python`: Debian does not ship an unversioned `python`.
ENTRYPOINT ["python3", "-m", "gsu"]
CMD ["run"]
