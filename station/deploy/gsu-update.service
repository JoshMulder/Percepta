# One update check. Driven by gsu-update.timer; safe to start by hand.
#
#   systemctl start gsu-update          # check now
#   journalctl -u gsu-update -n 50      # what it decided, and why

[Unit]
Description=Percepta ground station — check for and apply a container update
Documentation=file:/opt/percepta/station/DEPLOYMENT.md
# Ordering only. If there is no network the pull fails, the script says so and
# changes nothing — which is the correct outcome, not an error worth avoiding.
After=docker.service network.target
Wants=docker.service

[Service]
Type=oneshot
# Root: it drives the Docker socket. The agent itself does not, and must not —
# a container that can reach /var/run/docker.sock can replace itself with
# anything, which would make the health gate below decorative.
User=root
EnvironmentFile=/etc/percepta/gsu.env
ExecStart=/opt/percepta/station/deploy/gsu-update.sh

# Long enough for a slow pull over a degraded link plus both health gates (the
# new image's, and the previous image's if a rollback is needed). If it does
# take longer than this, being killed part-way is survivable: the script only
# ever moves the `current` tag after a successful pull, and the container is
# recreated from whatever that tag points at.
TimeoutStartSec=45min

# A failed update check is not a reason to mark anything degraded: the station
# keeps running the image it has, which is the whole design.
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
