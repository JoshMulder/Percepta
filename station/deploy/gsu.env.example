# Every key the ground station agent understands. **This is a reference, not a
# file that gets installed.**
#
# The file the station actually reads is `station/.env`, written by
# `bootstrap.sh` and mounted into the container by `docker-compose.yml`.
# Bootstrap writes three keys; everything below is what you can add by hand
# afterwards. Do not copy this file over `.env` wholesale — the values here are
# examples, and at least one of them (GSU_API_CA_FILE) is actively wrong for a
# platform behind a public certificate.
#
# This file holds addresses and policy. The only secret it may hold is
# GSU_SETUP_PASSWORD_HASH, and that is a hash rather than a password — see the
# setup-page section. The station's credential is issued at enrolment and lives
# in the state directory at 0600, never here. If you find yourself putting a
# broker or platform password in this file, something has gone wrong — see
# GSU_BROKER_URL below.

# --- where the platform is ------------------------------------------------
# The API address is yours to set. The broker address is not, normally: the
# platform states it at enrolment, and since the relay is served by the
# platform itself it is the same host — see GSU_BROKER_URL.
#
# TLS is not optional on either. https:// and wss://, or the agent refuses to
# talk (see GSU_REQUIRE_TLS).
GSU_PLATFORM_URL=https://platform.example.net:8000
# Normally EMPTY. The platform states its own broker address in the enrolment
# response, and since the relay is served by the platform itself that is
# `wss://<the host you enrolled against>/broker` — which is right on a bench
# and behind a proxy alike.
#
# Set this only to override that, which on a development stack usually means
# pointing at an address routable from where the station actually is.
GSU_BROKER_URL=

# GSU_BROKER_URL must contain an address and NOTHING ELSE. redis-py lets a URL
# override the credentials passed alongside it, so a URL carrying user:pass@
# would replace this station's identity with whatever it names. The agent
# strips and warns about that rather than obeying it, but the right answer is
# not to put credentials here in the first place: the station authenticates as
# gsu:{station_id} with the secret it was issued at enrolment.

# --- trust: TWO roots, not one --------------------------------------------
# The broker and the API are verified against different things, because they
# are different things. See gsu/tls.py.

# THE BROKER is always pinned to a private CA. Normally you do not set this at
# all: the CA arrives in the enrolment response as `broker.ca_pem` and is
# persisted at $GSU_HOME/broker-ca.pem, 0600, from then on. Set it only to
# pre-provision the CA before enrolling — useful if you want `gsu preflight
# --probe` to check the broker address before the station has an identity.
#GSU_CA_FILE=/etc/percepta/broker-ca.pem

# THE PLATFORM API is verified against the system CA bundle by default, which
# is the right answer when it sits behind a TLS-terminating reverse proxy with
# a public certificate for a real domain. **Nothing to configure in that case,
# and this line must stay commented out.**
#
# Set it only while the platform serves its own certificate. Pinning the API to
# a CA that will not be the one answering is not security, it is an outage with
# a certificate error attached — and that is not hypothetical: this key was
# left uncommented here, a station picked it up, the platform moved behind a
# proxy, and enrolment then failed with "unable to get local issuer
# certificate" against a CA that had been correct the week before.
#GSU_API_CA_FILE=/etc/percepta/platform-api-ca.pem

# Refuse plaintext outright on either link, even before any CA has been seen.
# On for any box that is not a developer's desk. With this set, a redis:// or
# http:// address is refused with a message rather than used.
#
# There is no setting anywhere that disables certificate verification.
GSU_REQUIRE_TLS=1

# --- this box -------------------------------------------------------------
# State: credential, pinned CA, device inventory, event database, recordings.
# Set by docker-compose.yml, not here: inside the container it is always this
# path, and what the host keeps it in is the `gsu-state` named volume. Listed
# for completeness — setting it in .env would be overridden.
GSU_HOME=/var/lib/percepta-gsu

# --- the setup page (contract/enrolment.md §5) ----------------------------
# The web GUI an installer uses to enter the enrolment code and choose what is
# fitted in each slot. It is the whole install for somebody with a laptop or a
# phone and no terminal; `python -m gsu` does the same jobs for somebody with a
# shell, and neither is the special case.
#
# **On the site LAN, on port 80, by default** — that is what an installer with
# a laptop and no terminal actually needs, and it is the job the page exists
# for. Port 80 rather than 443 because the console speaks plain HTTP and has no
# certificate: on 443 every browser would try HTTPS first and fail.
#
# The password is the control, not the interface. Four things stand between
# this page and the internet, described in full in station/gsu/setup_access.py:
#
#   1. GSU_SETUP_PASSWORD_HASH — WITHOUT IT THE PAGE IS NOT SERVED. The agent
#      demotes itself to the container's own loopback, which no port mapping
#      reaches, so forgetting one gives an unreachable page rather than an open
#      one. bootstrap.sh will not finish without collecting one;
#   2. GSU_SETUP_BIND, the host interface compose publishes to. 0.0.0.0 by
#      default; set it to a specific LAN address where you know one, or to
#      127.0.0.1 to go back to the SSH-tunnel-only arrangement;
#   3. the source address: a request from outside 10/8, 172.16/12, 192.168/16
#      or link-local is refused before it is parsed. **Whether this survives
#      Docker's port publishing has not been measured on the box** — with
#      iptables DNAT the real client address is preserved, with the userland
#      proxy it is not, and which one applies depends on the daemon. Do not
#      count on it;
#   4. GSU_SETUP_WINDOW_MINUTES, after which the page stops answering on the
#      LAN entirely.
#
# What crosses the wire in clear text on this arrangement: the setup password
# and the enrolment code. That is the cost of a page an installer can open, and
# it is why the window that closes matters.
#
# **Neither of these is the knob you want on the container path.**
# docker-compose.yml sets GSU_SETUP_HOST=0.0.0.0 inside the container, because
# the container's network namespace is the boundary and the agent cannot see
# the host's port mapping from in there; and 8088 is the port it listens on
# inside, which is not the port anybody types. GSU_SETUP_BIND and
# GSU_SETUP_HOST_PORT are the two that decide what a laptop can reach.
#GSU_SETUP_HOST=0.0.0.0
#GSU_SETUP_PORT=8088

# The password an installer types into the setup page. Required before the page
# will bind anywhere other than loopback; loopback callers never need it,
# because they arrived over SSH and that has already authenticated them.
#
# Generate with:   python -m gsu setup-password
# then write the password itself on the box, the way a router's is on a label.
# It is NOT the enrolment code — the enrolment code is single-use and issued by
# the platform, this is per-box and set when the box is provisioned.
#
# A plain GSU_SETUP_PASSWORD is also accepted for a bench, but the hash is
# strictly better for the same effort: it survives this file being read, and if
# both are set the hash wins.
#GSU_SETUP_PASSWORD_HASH=pbkdf2_sha256$120000$…$…

# How long the page stays reachable from the LAN with no authenticated
# activity, once the station is enrolled. While it is still UNENROLLED the
# window does not run down — an installer is mid-job and a box with no
# credential has nothing on it worth reaching.
#
# When the window closes the LAN socket is closed and rebound to loopback: the
# port stops answering rather than starting to answer 403, because this must
# not become a permanent service. Getting it back is a deliberate act —
# reboot the station, or `touch $GSU_HOME/setup-open` with a shell on the box.
#
# 0 pins it open. Only for a bench: it is logged as a warning at start and
# rendered on the page itself.
GSU_SETUP_WINDOW_MINUTES=30

# Provision this box as a demo station: every slot starts on its Demo sensor,
# so it is a complete working station — test card, weather, power, traffic —
# with no hardware attached.
#
# Off here on purpose. With it on, a real installation's first job is to
# un-demo six slots nobody asked for, and to notice that it needs doing; with
# it off, a slot nobody has touched reads "Not fitted", which is true.
#
# Provisioning, not runtime: it only seeds a box that has never been
# configured. Setting it later cannot replace real sensors, and clearing it
# later cannot strip a demo box somebody is using.
GSU_DEMO=0

# Simulated airband traffic: off | low | busy. With the real SDR selected there
# is no simulation at all and this does nothing, but leave it off so that a box
# accidentally left on the simulated receiver is obvious rather than plausible.
GSU_AIRBAND_TRAFFIC=off

# One-shot enrolment code for a headless first boot. Normally left unset: the
# technician types the code into the setup page. If it is set, it is a secret
# in a file, so remove it once the box is enrolled.
#GSU_ENROL_TOKEN=

# --- updates --------------------------------------------------------------
# There are no update keys, and that is the design. Updating is
#
#     git pull && docker compose up -d --build
#
# and rolling back is `git checkout` of a tag already on the disk. The updater
# daemon this section used to document — a jittered timer, an image registry, a
# health gate and an automatic rollback — went with the systemd deployment
# path. Nothing reads GSU_UPDATE_REF, GSU_GATE_SECONDS or GSU_CONSOLE_URL any
# more.

# Which host interface the setup page is published on, and on which port.
#
# `0.0.0.0` (the default) publishes it to the site LAN, which is what an
# installer with a laptop actually needs: http://<box>/ and nothing else to
# know. Prefer the setup interface's own address where you know one; 0.0.0.0 is
# the default because a DHCP setup network is real and its address is not
# knowable in advance.
#
# `127.0.0.1` puts it back on loopback, for a box whose LAN you do not trust:
#   ssh -L 8080:127.0.0.1:80 <this host>
#
# GSU_SETUP_HOST_PORT moves it off 80, for a box already serving something
# there. It is the *host* port; the container always listens on 8088.
#GSU_SETUP_BIND=0.0.0.0
#GSU_SETUP_HOST_PORT=80
