# Environment for the ground station agent, installed to /etc/percepta/gsu.env
# and read by the systemd unit. Owned root:gsu, mode 0640 — the agent reads it,
# nobody else does.
#
# This file holds addresses and policy. It holds no secrets: the station's
# credential is issued at enrolment and lives in the state directory at 0600.
# If you find yourself putting a password in here, something has gone wrong —
# see GSU_BROKER_URL below.

# --- where the platform is ------------------------------------------------
# Both the host and the port are yours to set. The station is told a broker
# address at enrolment, but the platform frequently reports an address that is
# only routable from inside its own network, so this override exists.
#
# TLS is not optional on either of these. https:// and rediss://, or the agent
# refuses to talk (see GSU_REQUIRE_TLS).
#
# The API is expected to move behind a TLS-terminating reverse proxy, so its
# host may become a real domain name while the broker stays where it is. They
# are separate settings for that reason — do not assume one host serves both.
GSU_PLATFORM_URL=https://platform.example.net:8000
GSU_BROKER_URL=rediss://platform.example.net:6380/0

# GSU_BROKER_URL must contain an address and NOTHING ELSE. redis-py lets a URL
# override the credentials passed alongside it, so a URL carrying user:pass@
# would replace this station's identity with whatever it names. The agent
# strips and warns about that rather than obeying it, but the right answer is
# not to put credentials here in the first place: the station authenticates as
# gsu:{station_id} with the secret it was issued at enrolment.

# --- trust: TWO roots, not one --------------------------------------------
# The broker and the API are verified against different things, because they
# are different things. See gsu/tls.py.

# THE BROKER is always pinned to a private CA. Normally you do not set this at
# all: the CA arrives in the enrolment response as `broker.ca_pem` and is
# persisted at $GSU_HOME/broker-ca.pem, 0600, from then on. Set it only to
# pre-provision the CA before enrolling — useful if you want `gsu preflight
# --probe` to check the broker address before the station has an identity.
#GSU_CA_FILE=/etc/percepta/broker-ca.pem

# THE PLATFORM API is verified against the system CA bundle by default, which
# is the right answer when it sits behind a TLS-terminating reverse proxy with
# a public certificate for a real domain. Nothing to configure in that case.
#
# Set this to pin the API to a specific CA instead. That IS the right setting
# while the platform serves its own certificate, as it does today — leave it
# commented out only once there is a proxy with a public certificate in front.
#
# It is opt-in rather than automatic because pinning the API to a CA that will
# not be the one answering is not security, it is an outage with a certificate
# error attached.
GSU_API_CA_FILE=/etc/percepta/platform-api-ca.pem

# Refuse plaintext outright on either link, even before any CA has been seen.
# On for any box that is not a developer's desk. With this set, a redis:// or
# http:// address is refused with a message rather than used.
#
# There is no setting anywhere that disables certificate verification.
GSU_REQUIRE_TLS=1

# --- this box -------------------------------------------------------------
# State: credential, pinned CA, device inventory, event database, recordings.
# Matches StateDirectory= in the unit, which creates it 0700 owned by gsu.
GSU_HOME=/var/lib/percepta-gsu

# The local setup console (contract/enrolment.md §5). Loopback by default,
# which means "reach it over an SSH tunnel". If a technician needs to open it
# from a phone or laptop on a setup network, bind it to THAT interface and
# nothing else — it has no authentication, and physical presence on a private
# setup network is the only control it has. Never bind it to an interface that
# routes to the internet.
GSU_SETUP_HOST=127.0.0.1
GSU_SETUP_PORT=8088

# Simulated airband traffic: off | low | busy. With the real SDR selected there
# is no simulation at all and this does nothing, but leave it off so that a box
# accidentally left on the simulated receiver is obvious rather than plausible.
GSU_AIRBAND_TRAFFIC=off

# One-shot enrolment code for a headless first boot. Normally left unset: the
# technician types the code into the setup page. If it is set, it is a secret
# in a file, so remove it once the box is enrolled.
#GSU_ENROL_TOKEN=

# --- updates (container deployment only) ----------------------------------
# What deploy/gsu-update.sh tracks. Nothing is checked or pulled until this is
# set — an unset value is a station that keeps running what it has, for ever,
# which is a safe default for a box nobody can reach.
#
# **Prefer a digest to a tag.** A tag can be moved under you; a digest cannot,
# and on a station that is hard to reach you want to know exactly what will
# arrive. Use a tag only if you want a fleet to follow a channel.
#
#   GSU_UPDATE_REF=registry.example.net/percepta/gsu@sha256:abc123…
#   GSU_UPDATE_REF=registry.example.net/percepta/gsu:stable
GSU_UPDATE_REF=

# How long a new image has to prove itself before it is rolled back. It must
# start, enrol, get its uplink up and *increase its published-frame counter* —
# a container that starts and publishes nothing is the failure this catches.
#
# 180s is generous for a station that is already enrolled. Raise it if the site
# has a slow link, because the gate includes getting the uplink up.
GSU_GATE_SECONDS=180

# Where the updater reads the station's own health from. Must match the port
# published in docker-compose.yml. If the setup console is ever disabled, the
# gate has nothing to read and updates will always roll back — deliberately, on
# the grounds that an update nobody can verify should not be kept.
GSU_CONSOLE_URL=http://127.0.0.1:8088/status.json
