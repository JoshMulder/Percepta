# Copy to .env and replace every change-me value. Never commit .env.

# --- Database ---------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=percepta

# Schema owner. Migrations, seeding, device enrolment, background workers.
# Bypasses row-level security.
POSTGRES_USER=percepta
POSTGRES_PASSWORD=change-me

# Least-privilege role the API tier uses (NOSUPERUSER, NOBYPASSRLS), so RLS
# actually constrains it. Names match DroneOps so the two are configured alike.
# Leave the password unset and the app falls back to the owner connection with
# RLS BYPASSED - it boots, but it is not representative, and tenant isolation is
# not being tested. bootstrap.sh generates one for you.
APP_DB_USER=percepta_app
APP_DB_PASSWORD=

# Set when running behind PgBouncer in transaction-pooling mode.
PGBOUNCER_ENABLED=false
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=6432

# --- Auth -------------------------------------------------------------------
SECRET_KEY=change-me

# Fernet key protecting TOTP seeds (and device credentials once enrolment
# lands). Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this up SEPARATELY from the database - losing it makes those columns
# unrecoverable, and storing it beside a dump defeats the control entirely.
SECRETS_ENCRYPTION_KEY=

# --- Redis ------------------------------------------------------------------
# Control leases, live fan-out between API processes, revocation push,
# single-use stream tickets.
REDIS_URL=redis://localhost:6379/0

# --- Real-time --------------------------------------------------------------
# How often an open WebSocket revalidates its session and station grants,
# independently of the Redis revocation push.
STREAM_REVALIDATE_SECONDS=60
STREAM_TICKET_SECONDS=60
