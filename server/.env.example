# Copy to .env and replace every change-me value. Never commit .env.

# --- Database ---------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=percepta

# Schema owner. Migrations, seeding, device enrolment, background workers.
# Bypasses row-level security.
POSTGRES_USER=percepta
POSTGRES_PASSWORD=change-me

# Least-privilege role the API tier uses (NOSUPERUSER, NOBYPASSRLS), so RLS
# actually constrains it. Names match DroneOps so the two are configured alike.
# Leave the password unset and the app falls back to the owner connection with
# RLS BYPASSED - it boots, but it is not representative, and tenant isolation is
# not being tested. bootstrap.sh generates one for you.
APP_DB_USER=percepta_app
APP_DB_PASSWORD=

# Set when running behind PgBouncer in transaction-pooling mode.
PGBOUNCER_ENABLED=false
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=6432

# --- Auth -------------------------------------------------------------------
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start while this is the example value.
SECRET_KEY=change-me

# Fernet key protecting TOTP seeds (and device credentials once enrolment
# lands). Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this up SEPARATELY from the database - losing it makes those columns
# unrecoverable, and storing it beside a dump defeats the control entirely.
SECRETS_ENCRYPTION_KEY=

# --- Redis ------------------------------------------------------------------
# Control leases, live fan-out between API processes, revocation push,
# single-use stream tickets.
REDIS_URL=redis://localhost:6379/0

# --- Real-time --------------------------------------------------------------
# How often an open WebSocket revalidates its session and station grants,
# independently of the Redis revocation push.
STREAM_REVALIDATE_SECONDS=60

# --- Basemap ----------------------------------------------------------------
# Slippy-tile URL template for the cached basemap, e.g.
#   https://tiles.example.com/{z}/{x}/{y}.png
#
# UNSET BY DEFAULT, DELIBERATELY. Percepta downloads tiles in bulk and serves
# them locally, because a ground station is fixed and its map is a finite set of
# tiles. Most public tile servers - OpenStreetMap's included - prohibit exactly
# that in their usage policy. Point this at a source you are licensed to cache:
# a commercial provider whose terms permit offline caching, or your own tile
# server built from OSM data.
# NOT IMPLEMENTED. Neither this nor TILE_ATTRIBUTION exists in core/config.py,
# and pydantic's extra="ignore" discards them without a word — so setting them
# does nothing at all. The real source is hardcoded in services/basemaps.py.
# Left here because the licensing problem they describe is real and unresolved;
# wire them up, or delete them, when the provider is chosen.
TILE_SOURCE_URL=

# NOT IMPLEMENTED — see above. This used to say "the console renders exactly
# what is set here", which was wrong twice: nothing reads it, and the console's
# attribution control does not mount at all with a single basemap configured.
TILE_ATTRIBUTION=

# Where cached tiles live inside the container (a named volume by default).
TILE_CACHE_DIR=/tiles

# --- Demo -------------------------------------------------------------------
# Marks the deployment as showing synthetic data: the console badges every
# screen and stops flagging sensors as faulty (in demo the simulator is the
# sensor). Changes no authorisation and no tenant isolation.
DEMO_MODE=false

# Comma-separated station uuids the simulator must leave alone - any station
# driven by real hardware or another developer.
SIMULATOR_EXCLUDE_STATIONS=

# The first administrator, created at start-up if absent. Leave the password
# blank and the account exists but cannot be signed in to until one is set.
# Changing it later does NOT reset an existing account - use the console, so the
# change is audited.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=

# --- Broker -----------------------------------------------------------------
# Closes Redis' default user. Without it, anything that can reach the port can
# publish as any station, which makes the per-station ACL principals decorative.
REDIS_PASSWORD=

# The platform's own connection. rediss:// and a CA path - the broker is TLS
# only, and its plaintext listener is disabled.
#   REDIS_URL=rediss://:<password>@redis:6379/0?ssl_ca_certs=/certs/ca.crt

# 0.0.0.0 lets a ground station reach the broker from off-box. Safe because the
# listener is TLS and authenticated; leave it on loopback if no station connects.
REDIS_BIND=127.0.0.1

# What an enrolling station is told to connect to. Must be reachable FROM the
# station and must appear in the certificate's SANs (see scripts/make_certs.sh).
# Deliberately carries no credentials: the station authenticates as its own
# principal, and redis-py would let a URL password override that silently.
# Normally empty. The station relay is served by this application, so the
# platform derives wss://<host>/broker from the host an enrolling station
# actually reached — which is the only thing that survives a reverse proxy.
# Set this only for a deployment that really does put the broker elsewhere.
STATION_BROKER_URL=

# --- TLS --------------------------------------------------------------------
# Generated by scripts/make_certs.sh. The CA is handed to each station at
# enrolment and pinned; back up certs/ca.key somewhere else, because losing it
# means re-enrolling every station in the field.
#   PERCEPTA_HOSTS=percepta.example.com,203.0.113.10 ./scripts/make_certs.sh

# --- Private image registry & remote update (server/docs/07) ---------------
# The `registry` service authenticates pulls through this platform's token
# endpoint, so a station pulls with the bearer credential it already holds from
# enrolment. Loopback by default; set 0.0.0.0 so a reverse proxy on another host
# can reach it (token auth makes LAN exposure safe).
REGISTRY_BIND=127.0.0.1
REGISTRY_HOST_PORT=5000

# The token endpoint (realm), the JWT audience (service) and the issuer. These
# are LOGICAL names stamped into and verified against every token — they must
# match on both sides but need not equal the pull address. Hostnames, never IPs.
GSU_REGISTRY_TOKEN_REALM=https://percepta.aeronavics.com/v2/token
GSU_REGISTRY_SERVICE=registry.percepta.aeronavics.com
GSU_REGISTRY_ISSUER=percepta-platform

# The release box's push credential (the Makefile reads it as REGISTRY_USER /
# REGISTRY_TOKEN). A station gets pull only; this robot also gets push.
# bootstrap.sh generates the token; a station never sees it.
REGISTRY_ROBOT_USER=robot
REGISTRY_ROBOT_TOKEN=

# Registry storage on S3/R2 (optional). By default the registry keeps blobs on a
# local volume. To hold NO state on this box — the shape that makes a cloud move
# lift-and-shift — put storage on object storage (e.g. Cloudflare R2) and bring
# the registry up with the overlay:
#   docker compose -f docker-compose.yaml -f docker-compose.r2.yaml up -d registry
REGISTRY_S3_ENDPOINT=
REGISTRY_S3_BUCKET=
REGISTRY_S3_ACCESS_KEY=
REGISTRY_S3_SECRET_KEY=
REGISTRY_S3_REGION=auto
# false = redirect blob downloads straight to R2 (presigned), off the tunnel.
REGISTRY_S3_REDIRECT_DISABLE=false

# --- Platform URL (ops/debug scripts in scripts/) --------------------------
# The base URL this platform is reachable on, for the scripts under scripts/
# (checkenrol, screenshot, …). A hostname, never a fixed IP, so the same
# checkout works from any host and after a move. Each script also honours a
# PERCEPTA_URL environment variable, which overrides this.
PERCEPTA_URL=https://percepta.aeronavics.com

# --- Outbound email ---------------------------------------------------------
# Dormant until SMTP_HOST and SMTP_FROM are both set; the app then raises on a
# failed send rather than dropping mail silently.
#
# Development uses the mailpit service in docker-compose: SMTP on 1025, and a
# web inbox on http://127.0.0.1:8025 where every message is readable. Nothing
# leaves the host. Remove that service in production and point this at a relay.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=percepta@localhost
SMTP_USE_TLS=false
SMTP_USE_SSL=false

# Where password-reset links point. Set it to the address a browser actually
# reaches the console on. It is NOT derived from the incoming request: the Host
# header is attacker-controlled, and that is the classic way reset links get
# sent pointing at somebody else's server.
CONSOLE_BASE_URL=https://localhost:8000

# How long a reset link lasts. It is a bearer token sitting in a mailbox.
PASSWORD_RESET_TTL_HOURS=12
