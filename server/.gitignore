.env
.venv/
# There is no node on the host here — the console is built, and its tests run,
# inside a container (see web/src/emitters.test.ts). Whichever way npm is
# invoked it writes this into the working tree, and it is already excluded from
# the Docker build context by .dockerignore.
web/node_modules/
# Console build output. The app image builds it in its own stage; these only
# appear on the host when npm is run against a bind mount.
web/dist/
web/tsconfig.tsbuildinfo
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
storage/
*.log

# Claude Code local, machine-specific settings
.claude/settings.local.json

# Private CA and server keys. Never committed: the CA key is what lets anyone
# impersonate the platform to every station that has pinned it.
certs/

# Database dumps. Contain every tenant's data.
backups/
